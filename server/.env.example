# Local Node process using the services in compose.yml.
DATABASE_URL=postgres://billing:billing@127.0.0.1:55432/billing
SETTINGS_DATABASE_URL=postgres://settings:settings@127.0.0.1:55433/billing_settings
AMQP_URL=amqp://billing:billing@127.0.0.1:5672
HOST=127.0.0.1
PORT=3000
# Vite's /api proxy targets this Gateway.
API_URL=http://127.0.0.1:3000
DEVTOOLS=1
LOG_LEVEL=info
REGISTRY_DELAY_MS=0
# Match PARTITIONS across all running replicas when sharing an existing database.
PARTITIONS=1
PG_POOL_MAX=20
